# =============================================================================
# Pragati Bharati — Environment Configuration
# Copy to .env and fill in real values. NEVER commit .env to version control.
# =============================================================================

# --- Database ---
POSTGRES_USER=pragati
POSTGRES_PASSWORD=change_me_in_production
POSTGRES_DB=pragati_bharati
DATABASE_URL=postgresql://pragati:change_me_in_production@postgres:5432/pragati_bharati

# --- Redis ---
REDIS_URL=redis://redis:6379/0

# --- JWT Auth ---
JWT_SECRET_KEY=change-this-to-a-random-64-char-string
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- File Upload & Size Policy ---
MAX_UPLOAD_SIZE_HARD_MB=50
MAX_UPLOAD_SIZE_SOFT_MB=15
TARGET_COMPRESSED_SIZE_MB=10
MAX_PAGE_COUNT=300
MAX_IMAGE_DIMENSION_PX=4000

# --- Storage ---
STORAGE_BACKEND=local
STORAGE_BASE_PATH=/app/storage
# For S3/MinIO:
# S3_ENDPOINT_URL=http://minio:9000
# S3_ACCESS_KEY=minioadmin
# S3_SECRET_KEY=minioadmin
# S3_BUCKET_NAME=pragati-documents

# --- OCR ---
OCR_ENGINE=tesseract
# TESSERACT_CMD=/usr/bin/tesseract
# For Google Document AI:
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json
# GOOGLE_PROJECT_ID=your-project-id
# GOOGLE_PROCESSOR_ID=your-processor-id

# --- Confidence Thresholds ---
CONFIDENCE_AUTO_ACCEPT=0.85
CONFIDENCE_REVIEW_THRESHOLD=0.50

# --- Confidence Score Weights (must sum to 1.0) ---
CONFIDENCE_WEIGHT_OCR=0.30
CONFIDENCE_WEIGHT_NUMBER_DETECTION=0.20
CONFIDENCE_WEIGHT_OPTION_COMPLETENESS=0.20
CONFIDENCE_WEIGHT_BOUNDARY_QUALITY=0.15
CONFIDENCE_WEIGHT_ANSWER_MATCH=0.15

# --- Rate Limiting ---
RATE_LIMIT_UPLOADS_PER_MINUTE=10
RATE_LIMIT_UPLOADS_BURST=5

# --- Celery ---
CELERY_TASK_TIMEOUT=600
CELERY_TASK_MAX_RETRIES=3
CELERY_STALE_JOB_THRESHOLD_MINUTES=30

# --- Security ---
ALLOWED_MIME_TYPES=application/pdf,image/jpeg,image/png
VIRUS_SCAN_ENABLED=false
# CLAMAV_HOST=clamav
# CLAMAV_PORT=3310

# --- Preprocessing ---
TARGET_DPI=200
DESKEW_ENABLED=true
DENOISE_ENABLED=true
