{
  "info": {
    "name": "Pragati Bharati — Document Intelligence API",
    "description": "Full demo workflow for the Document Processing & Question Extraction Service.\n\nSetup:\n1. Run `docker-compose up`\n2. Execute requests in order (Register → Login → Upload → ...)\n3. The {{jwt_token}} variable is auto-set by the Login request",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {"key": "base_url", "value": "http://localhost:8000"},
    {"key": "jwt_token", "value": ""},
    {"key": "document_id", "value": ""},
    {"key": "question_id", "value": ""},
    {"key": "answer_key_id", "value": ""},
    {"key": "review_item_id", "value": ""}
  ],
  "item": [
    {
      "name": "1. Health Check",
      "request": {
        "method": "GET",
        "url": "{{base_url}}/healthz",
        "description": "Verify API, database, and Redis are healthy. No auth required."
      }
    },
    {
      "name": "2. Register User",
      "request": {
        "method": "POST",
        "url": "{{base_url}}/auth/register",
        "header": [{"key": "Content-Type", "value": "application/json"}],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"demo@pragati.edu\",\n  \"password\": \"demopassword123\"\n}"
        }
      }
    },
    {
      "name": "3. Login (captures JWT)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "var json = pm.response.json();",
              "if (json.access_token) {",
              "  pm.collectionVariables.set('jwt_token', json.access_token);",
              "  console.log('JWT captured: ' + json.access_token.substring(0, 20) + '...');",
              "}"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "url": "{{base_url}}/auth/login",
        "header": [{"key": "Content-Type", "value": "application/json"}],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"demo@pragati.edu\",\n  \"password\": \"demopassword123\"\n}"
        }
      }
    },
    {
      "name": "4. Upload Question Paper",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "var json = pm.response.json();",
              "if (json.document_id) {",
              "  pm.collectionVariables.set('document_id', json.document_id);",
              "  console.log('Document ID: ' + json.document_id);",
              "}"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "url": "{{base_url}}/documents",
        "header": [
          {"key": "Authorization", "value": "Bearer {{jwt_token}}"}
        ],
        "body": {
          "mode": "formdata",
          "formdata": [
            {"key": "file", "type": "file", "description": "Select a PDF or image file"},
            {"key": "doc_role", "value": "QUESTION_PAPER", "type": "text"}
          ]
        }
      }
    },
    {
      "name": "5. Poll Document Status",
      "request": {
        "method": "GET",
        "url": "{{base_url}}/documents/{{document_id}}/status",
        "header": [
          {"key": "Authorization", "value": "Bearer {{jwt_token}}"}
        ],
        "description": "Poll until status is COMPLETED, PARTIAL, or FAILED."
      }
    },
    {
      "name": "6. List All Documents",
      "request": {
        "method": "GET",
        "url": "{{base_url}}/documents?page=1&page_size=10",
        "header": [
          {"key": "Authorization", "value": "Bearer {{jwt_token}}"}
        ]
      }
    },
    {
      "name": "7. Get Extracted Questions",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "var json = pm.response.json();",
              "if (json.items && json.items.length > 0) {",
              "  pm.collectionVariables.set('question_id', json.items[0].question_id);",
              "  console.log('First question ID: ' + json.items[0].question_id);",
              "}"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "url": "{{base_url}}/documents/{{document_id}}/questions?page=1&page_size=20",
        "header": [
          {"key": "Authorization", "value": "Bearer {{jwt_token}}"}
        ]
      }
    },
    {
      "name": "8. Get Single Question Detail",
      "request": {
        "method": "GET",
        "url": "{{base_url}}/questions/{{question_id}}",
        "header": [
          {"key": "Authorization", "value": "Bearer {{jwt_token}}"}
        ]
      }
    },
    {
      "name": "9. Get Question Answer",
      "request": {
        "method": "GET",
        "url": "{{base_url}}/questions/{{question_id}}/answer",
        "header": [
          {"key": "Authorization", "value": "Bearer {{jwt_token}}"}
        ]
      }
    },
    {
      "name": "10. Upload Answer Key",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "var json = pm.response.json();",
              "if (json.document_id) {",
              "  pm.collectionVariables.set('answer_key_id', json.document_id);",
              "}"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "url": "{{base_url}}/documents",
        "header": [
          {"key": "Authorization", "value": "Bearer {{jwt_token}}"}
        ],
        "body": {
          "mode": "formdata",
          "formdata": [
            {"key": "file", "type": "file", "description": "Select the answer key file"},
            {"key": "doc_role", "value": "ANSWER_KEY", "type": "text"}
          ]
        }
      }
    },
    {
      "name": "11. Link Answer Key to Question Paper",
      "request": {
        "method": "POST",
        "url": "{{base_url}}/documents/{{document_id}}/link",
        "header": [
          {"key": "Authorization", "value": "Bearer {{jwt_token}}"},
          {"key": "Content-Type", "value": "application/json"}
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"linked_document_id\": \"{{answer_key_id}}\",\n  \"relation_type\": \"ANSWER_KEY_FOR\"\n}"
        }
      }
    },
    {
      "name": "12. Check Review Queue",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "var json = pm.response.json();",
              "if (json.items && json.items.length > 0) {",
              "  pm.collectionVariables.set('review_item_id', json.items[0].id);",
              "}"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "url": "{{base_url}}/review-queue?resolved=false&page=1&page_size=10",
        "header": [
          {"key": "Authorization", "value": "Bearer {{jwt_token}}"}
        ]
      }
    },
    {
      "name": "13. Resolve Review Item",
      "request": {
        "method": "PATCH",
        "url": "{{base_url}}/review-queue/{{review_item_id}}",
        "header": [
          {"key": "Authorization", "value": "Bearer {{jwt_token}}"},
          {"key": "Content-Type", "value": "application/json"}
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"resolved\": true,\n  \"notes\": \"Verified manually\"\n}"
        }
      }
    },
    {
      "name": "14. Get Page Image",
      "request": {
        "method": "GET",
        "url": "{{base_url}}/documents/{{document_id}}/pages/1/image",
        "header": [
          {"key": "Authorization", "value": "Bearer {{jwt_token}}"}
        ],
        "description": "Auth-gated page image retrieval. Returns PNG image."
      }
    },
    {
      "name": "15. Get Processing Jobs",
      "request": {
        "method": "GET",
        "url": "{{base_url}}/documents/{{document_id}}/jobs",
        "header": [
          {"key": "Authorization", "value": "Bearer {{jwt_token}}"}
        ],
        "description": "View the processing pipeline stage history."
      }
    }
  ]
}
